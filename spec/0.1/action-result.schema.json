{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfacerelay.dev/spec/0.1/action-result.schema.json",
  "title": "SurfaceRelay Action Result 0.1 Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "correlationId"
  ],
  "properties": {
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "rejected",
        "confirmation_required"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "data": {},
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {}
      }
    },
    "confirmation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "challengeId",
        "summary"
      ],
      "properties": {
        "challengeId": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
