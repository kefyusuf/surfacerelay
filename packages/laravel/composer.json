{
  "name": "surfacerelay/laravel",
  "description": "Experimental Laravel reference runtime for SurfaceRelay.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/validation": "^12.0|^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "SurfaceRelay\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SurfaceRelay\\Laravel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
